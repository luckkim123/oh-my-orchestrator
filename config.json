{
  "version": "1.0",
  "install_dir": "~/.claude",
  "log_file": "install.log",
  "modules": {
    "omo": {
      "enabled": true,
      "description": "omo role-based vendor consultation; the Claude session executes",
      "agents": {
        "oracle": {
          "backend": "claude",
          "model": "claude-opus-5",
          "reasoning": "high",
          "yolo": true
        },
        "security": {
          "backend": "codex",
          "model": "gpt-5.6-terra",
          "reasoning": "xhigh",
          "yolo": false
        },
        "develop": {
          "backend": "codex",
          "model": "gpt-5.6-terra",
          "reasoning": "xhigh",
          "yolo": true
        },
        "librarian": {
          "backend": "claude",
          "model": "claude-sonnet-5",
          "reasoning": "medium",
          "yolo": true
        },
        "explore": {
          "backend": "codex",
          "model": "gpt-5.6-terra",
          "reasoning": "low",
          "yolo": false
        },
        "frontend-ui-ux-engineer": {
          "backend": "claude",
          "model": "claude-sonnet-5",
          "reasoning": "medium",
          "yolo": true
        },
        "document-writer": {
          "backend": "claude",
          "model": "claude-sonnet-5",
          "reasoning": "medium",
          "yolo": true
        }
      },
      "operations": [
        {
          "type": "copy_file",
          "source": "skills/omo/SKILL.md",
          "target": "skills/omo/SKILL.md",
          "description": "Install omo skill"
        },
        {
          "type": "copy_file",
          "source": "skills/omo/references/oracle.md",
          "target": "skills/omo/references/oracle.md",
          "description": "Install oracle agent prompt"
        },
        {
          "type": "copy_file",
          "source": "skills/omo/references/librarian.md",
          "target": "skills/omo/references/librarian.md",
          "description": "Install librarian agent prompt"
        },
        {
          "type": "copy_file",
          "source": "skills/omo/references/explore.md",
          "target": "skills/omo/references/explore.md",
          "description": "Install explore agent prompt"
        },
        {
          "type": "copy_file",
          "source": "skills/omo/references/frontend-ui-ux-engineer.md",
          "target": "skills/omo/references/frontend-ui-ux-engineer.md",
          "description": "Install frontend-ui-ux-engineer agent prompt"
        },
        {
          "type": "copy_file",
          "source": "skills/omo/references/document-writer.md",
          "target": "skills/omo/references/document-writer.md",
          "description": "Install document-writer agent prompt"
        },
        {
          "type": "copy_file",
          "source": "skills/omo/references/develop.md",
          "target": "skills/omo/references/develop.md",
          "description": "Install develop agent prompt"
        },
        {
          "type": "copy_file",
          "source": "skills/omo/references/security.md",
          "target": "skills/omo/references/security.md",
          "description": "Install develop agent prompt"
        },
        {
          "type": "copy_file",
          "source": "skills/omo/references/vendor-ops.md",
          "target": "skills/omo/references/vendor-ops.md",
          "description": "Install vendor operations reference"
        },
        {
          "type": "copy_file",
          "source": "skills/omo/references/shared-context.md",
          "target": "skills/omo/references/shared-context.md",
          "description": "Install shared-context reference"
        },
        {
          "type": "copy_file",
          "source": "skills/omo/references/decision-record.md",
          "target": "skills/omo/references/decision-record.md",
          "description": "Install decision-record reference"
        },
        {
          "type": "copy_file",
          "source": "skills/omo/references/lane-boundary.md",
          "target": "skills/omo/references/lane-boundary.md",
          "description": "Install lane-boundary reference"
        }
      ]
    },
    "harness": {
      "enabled": true,
      "description": "Multi-session autonomous agent harness with progress checkpointing, failure recovery, task dependencies, and post-completion self-reflection",
      "operations": [
        {
          "type": "copy_dir",
          "source": "skills/harness",
          "target": "skills/harness",
          "description": "Install harness skill with hooks (Stop, SessionStart, TeammateIdle, SubagentStop, self-reflect)"
        }
      ]
    }
  }
}
